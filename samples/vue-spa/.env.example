# Copy to .env.local (Vite reads it) and start the dev server.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Same-origin prefixes served by the dev proxy (see vite.config.ts).
VITE_NERVES_IDP=/idp
VITE_NERVES_GATEWAY=/gateway

VITE_NERVES_CLIENT_ID=nerves-admin
# Must be registered on the client verbatim. Keep the port in sync with SPA_PORT.
VITE_NERVES_REDIRECT_URI=http://127.0.0.1:5178/auth/callback
# offline_access is what makes the IdP issue a refresh token (rotated on every use).
VITE_NERVES_SCOPES=openid profile email nerves.api offline_access

# Dev-server side only (not exposed to the browser).
SPA_PORT=5178
NERVES_IDP=http://127.0.0.1:5101
NERVES_GATEWAY=http://127.0.0.1:5100
