# Copy to .env, fill in the two credentials, then: set -a && . ./.env && set +a

# IdP and gateway of your local stack (docker compose defaults).
NERVES_IDP=http://127.0.0.1:5101
NERVES_GATEWAY=http://127.0.0.1:5100

# Public client (authorization code + PKCE). "nerves-admin" is seeded in
# Development by OpenIddictSeed; register your own in production.
NERVES_CLIENT_ID=nerves-admin

# Must match one of the client's registered redirect URIs exactly.
NERVES_REDIRECT_URI=http://127.0.0.1:5300/oidc-callback.html

# offline_access is what makes the IdP issue a refresh token (rotated on every use).
NERVES_SCOPES=openid profile email nerves.api offline_access

# Local development seed account. Never use a real account here.
NERVES_USERNAME=admin
NERVES_PASSWORD=

# Optional. Empty means the IdP default realm.
NERVES_REALM=
