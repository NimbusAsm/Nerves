# Copy to .env, then: set -a && . ./.env && set +a && npm start

NERVES_IDP=http://127.0.0.1:5101
NERVES_GATEWAY=http://127.0.0.1:5100

NERVES_CLIENT_ID=nerves-admin
# Must match a redirect URI registered on the client, verbatim.
NERVES_REDIRECT_URI=http://127.0.0.1:4311/auth/callback
# offline_access is what makes the IdP issue a refresh token (rotated on every use).
NERVES_SCOPES=openid profile email nerves.api offline_access

# Port this BFF listens on; keep it in sync with the redirect URI above.
BFF_PORT=4311
