{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Smtp": {
    "Disabled": true,
    "Host": "",
    "Port": 587,
    "From": "noreply@nerves.local",
    "Tls": true,
    "TimeoutSeconds": 30
  },
  "Sms": {
    "Disabled": true,
    "Provider": "webhook",
    "TwilioBaseUrl": "https://api.twilio.com",
    "TimeoutSeconds": 30
  },
  "Delivery": {
    "SweepSeconds": 30,
    "MaxAttempts": 5,
    "BaseDelaySeconds": 60,
    "MaxDelaySeconds": 3600,
    "BatchSize": 20
  },
  "Events": {
    "Consumer": {
      "Enabled": false,
      "IdentityBaseUrl": "http://127.0.0.1:5102",
      "PollSeconds": 30,
      "BatchSize": 50,
      "LookbackSeconds": 2,
      "Issuer": "https://nerves.local/"
    }
  }
}
