{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Identity": {
    "GrpcAddress": "http://127.0.0.1:5202",
    "DefaultRealm": "nerves"
  },
  "OpenIddictSeed": {
    "Enabled": true,
    "ClientId": "nerves-demo",
    "DisplayName": "Nerves demo client",
    "RedirectUris": [
      "http://127.0.0.1:5100/signin-oidc",
      "http://127.0.0.1:5101/api/v1/auth/federation/callback"
    ],
    "PostLogoutRedirectUris": [
      "http://127.0.0.1:5100/signout-callback-oidc"
    ],
    "AdminClientId": "nerves-admin",
    "AdminRedirectUris": [
      "http://127.0.0.1:5300/oidc-callback.html"
    ],
    "AdminPostLogoutRedirectUris": [
      "http://127.0.0.1:5300/"
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=127.0.0.1;Port=55440;Database=nerves;Username=nerves;Password=nerves"
  },
  "Session": {
    "GrpcAddress": "http://127.0.0.1:5203"
  },
  "Authorization": {
    "GrpcAddress": "http://127.0.0.1:5204"
  },
  "Audit": {
    "GrpcAddress": "http://127.0.0.1:5205"
  },
  "Cors": {
    "AdminOrigins": [
      "http://127.0.0.1:5300",
      "http://localhost:5300"
    ]
  },
  "BackchannelLogout": {
    "Clients": [
      {
        "ClientId": "nerves-demo",
        "LogoutUri": "http://127.0.0.1:5355/logout"
      }
    ]
  },
  "Federation": {
    "Providers": [
      {
        "Id": "upstream",
        "DisplayName": "Upstream OIDC",
        "Authority": "http://127.0.0.1:5101",
        "ClientId": "nerves-demo",
        "RedirectUri": "http://127.0.0.1:5101/api/v1/auth/federation/callback",
        "Scope": "openid profile email",
        "AllowSignUp": false
      }
    ]
  },
  "Ldap": {
    "Enabled": true,
    "Host": "127.0.0.1",
    "Port": 3389,
    "UseSsl": false,
    "BindDn": "cn=admin,dc=example,dc=com",
    "BindPassword": "admin",
    "BaseDn": "dc=example,dc=com",
    "UserFilter": "(uid={0})",
    "MailAttribute": "mail",
    "TimeoutSeconds": 3
  },
  "DataProtection": {
    "KeysDirectory": "/tmp/nerves-dp-keys"
  }
}
