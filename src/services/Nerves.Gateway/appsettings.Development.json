{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Admin": {
    "Realm": "nerves"
  },
  "Cors": {
    "AdminOrigins": [
      "http://127.0.0.1:5300",
      "http://localhost:5300"
    ]
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5100",
        "Protocols": "Http1"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "sessions-by-account": {
        "Order": 1,
        "ClusterId": "session",
        "Match": {
          "Path": "/api/v1/accounts/{accountId}/sessions"
        }
      },
      "sessions": {
        "Order": 2,
        "ClusterId": "session",
        "Match": {
          "Path": "/api/v1/sessions/{**catch-all}"
        }
      },
      "roles": {
        "Order": 3,
        "ClusterId": "authorization",
        "Match": {
          "Path": "/api/v1/roles/{**catch-all}"
        }
      },
      "permissions": {
        "Order": 4,
        "ClusterId": "authorization",
        "Match": {
          "Path": "/api/v1/permissions/{**catch-all}"
        }
      },
      "audit": {
        "Order": 5,
        "ClusterId": "audit",
        "Match": {
          "Path": "/api/v1/audit-events/{**catch-all}"
        }
      },
      "stats": {
        "Order": 6,
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/v1/stats"
        }
      },
      "accounts": {
        "Order": 7,
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/v1/accounts/{**catch-all}"
        }
      },
      "legal-entities": {
        "Order": 8,
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/v1/legal-entities/{**catch-all}"
        }
      },
      "organizations": {
        "Order": 9,
        "ClusterId": "directory",
        "Match": {
          "Path": "/api/v1/organizations/{**catch-all}"
        }
      },
      "invitations": {
        "Order": 10,
        "ClusterId": "directory",
        "Match": {
          "Path": "/api/v1/invitations/{**catch-all}"
        }
      },
      "compliance": {
        "Order": 11,
        "ClusterId": "compliance",
        "Match": {
          "Path": "/api/v1/compliance/{**catch-all}"
        }
      },
      "scim-users": {
        "Order": 12,
        "ClusterId": "identity",
        "Match": {
          "Path": "/scim/v2/Users/{**catch-all}"
        }
      },
      "scim-groups": {
        "Order": 13,
        "ClusterId": "authorization",
        "Match": {
          "Path": "/scim/v2/Groups/{**catch-all}"
        }
      },
      "idp-admin": {
        "Order": 14,
        "ClusterId": "idp",
        "Match": {
          "Path": "/api/v1/admin/integrations"
        }
      },
      "authz-admin": {
        "Order": 15,
        "ClusterId": "authorization",
        "Match": {
          "Path": "/api/v1/admin/pdp"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:5102/"
          }
        }
      },
      "session": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:5103/"
          }
        }
      },
      "authorization": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:5104/"
          }
        }
      },
      "audit": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:5105/"
          }
        }
      },
      "directory": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:5106/"
          }
        }
      },
      "compliance": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:5107/"
          }
        }
      },
      "idp": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:5101/"
          }
        }
      }
    }
  }
}
